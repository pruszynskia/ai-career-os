# Copy to .env.local (git-ignored) and fill in. .env.local is the single
# local env file — Next.js loads it for `dev`/`build`, and `npm run db:seed`
# reads it directly. If you use the Vercel CLI, `vercel env pull` also writes
# here; decline the overwrite or keep the Vercel project's vars in sync.

# --- Supabase (from the project's API settings / Vercel integration) ---
NEXT_PUBLIC_STORAGE_SUPABASE_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_STORAGE_SUPABASE_SUPABASE_ANON_KEY="change-me"
# Server-only — never expose with a NEXT_PUBLIC_ prefix. Used only by
# scripts/create-owner-user.ts to provision the single owner account.
STORAGE_SUPABASE_SUPABASE_SERVICE_ROLE_KEY="change-me"

# Public origin of this deployment (no trailing slash). Used to build the
# redirect links embedded in Supabase confirmation / password-reset emails.
# Leave unset for local dev; request headers are used as a fallback.
NEXT_PUBLIC_SITE_URL="https://your-app.example.com"

# --- db:seed inputs (scripts/create-owner-user.ts), not read at runtime ---
AUTH_OWNER_EMAIL="admin@admin.com"
AUTH_OWNER_PASSWORD="admin123"

# --- AI provider: "anthropic", "openai", or "gemini" ---
AI_PROVIDER="gemini"
ANTHROPIC_API_KEY="change-me"
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY="change-me"
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY="change-me"
GEMINI_MODEL="gemini-3.6-flash"

# --- Stripe (billing, TASK-056) ---
STRIPE_SECRET_KEY="change-me"
STRIPE_WEBHOOK_SECRET="change-me"
STRIPE_PRICE_ID_PRO="change-me"

# --- Local tooling only ---
# Used by the `supabase` CLI (db push / migrations), not by the app.
SUPABASE_DB_PASSWORD="change-me"
# VERCEL_OIDC_TOKEN is written and refreshed automatically by the Vercel CLI.
