{
  "$schema_note": "AI Career OS design tokens v1 (2026-09-23). Midnight Mint neutrals + teal accent. Source of truth for globals.css; see DESIGN-SYSTEM.md for usage rules.",
  "meta": { "name": "AI Career OS", "version": "1.0.0", "themes": ["dark", "light"], "defaultTheme": "dark" },

  "color": {
    "background": {
      "canvas":  { "dark": "#0A0E14", "light": "#FFFFFF", "css": "--background", "use": "Page background" },
      "sidebar": { "dark": "#000000", "light": "#F6F7F9", "css": "--sidebar", "use": "App sidebar, mobile tab bar, status footer" },
      "sunken":  { "dark": "#07090D", "light": "#F2F4F6", "css": "--surface-sunken", "use": "Inputs (dark), table group headers, closed lanes" },
      "raised":  { "dark": "#161B24", "light": "#FFFFFF", "css": "--popover", "use": "Dialogs, popovers, menus, toasts (always with overlay shadow)" },
      "hover":   { "dark": "#1C1F26", "light": "#F4F5F7", "css": "--muted", "use": "Row/nav hover, selected row, active nav item, skeleton blocks" }
    },
    "border": {
      "subtle":  { "dark": "#1C1F26", "light": "#E6E8EC", "css": "--border", "use": "Row dividers, section rules" },
      "default": { "dark": "#2D3642", "light": "#D2D6DC", "css": "--border-default", "use": "Cards/sections, buttons (secondary), chips, table containers" },
      "control": { "dark": "#5B6778", "light": "#7A8494", "css": "--input", "use": "Text inputs, selects, textareas, checkboxes (≥3:1 for WCAG 1.4.11)" },
      "strong":  { "dark": "#AEB6C2", "light": "#2D3642", "css": "--border-strong", "use": "Featured card (Pro plan), selected chip" }
    },
    "text": {
      "primary":   { "dark": "#E8ECF1", "light": "#0A0E14", "css": "--foreground" },
      "secondary": { "dark": "#AEB6C2", "light": "#2D3642", "css": "--foreground-secondary" },
      "muted":     { "dark": "#818B99", "light": "#5B6472", "css": "--muted-foreground", "use": "Meta, captions, placeholders, table headers" },
      "onAccent":  { "dark": "#042F2E", "light": "#FFFFFF", "css": "--primary-foreground" }
    },
    "accent": {
      "default": { "dark": "#2DD4BF", "light": "#0F766E", "css": "--primary", "use": "Primary buttons, links on dark, focus ring, progress, selection edge, score bars" },
      "hover":   { "dark": "#5EEAD4", "light": "#115E59", "css": "--primary-hover" },
      "pressed": { "dark": "#14B8A6", "light": "#134E4A", "css": "--primary-pressed" },
      "subtle":  { "dark": "#0B2A28", "light": "#E6F7F5", "css": "--primary-subtle", "use": "Success banner, drop-target fill" }
    },
    "status": {
      "warning":       { "dark": "#F5B452", "light": "#B45309", "css": "--warning", "use": "Urgency only: follow-up due, expiring, pending connection, notification dot" },
      "warningSubtle": { "dark": "#2A2211", "light": "#FEF4E6", "css": "--warning-subtle" },
      "danger":        { "dark": "#F87171", "light": "#C2261D", "css": "--destructive" },
      "dangerHover":   { "dark": "#FCA5A5", "light": "#A31F17", "css": "--destructive-hover" },
      "dangerSubtle":  { "dark": "#2A1215", "light": "#FDECEC", "css": "--destructive-subtle" },
      "onDanger":      { "dark": "#140404", "light": "#FFFFFF", "css": "--destructive-foreground" },
      "success":       { "alias": "accent.default", "css": "--success" }
    },
    "tier": {
      "applyImmediately":  { "dark": "#2DD4BF", "light": "#0D9488", "css": "--tier-1" },
      "strongOpportunity": { "dark": "#0D9488", "light": "#134E4A", "css": "--tier-2" },
      "consider":          { "dark": "#5B6778", "light": "#8A94A3", "css": "--tier-3" },
      "ignore":            { "dark": "#2D3642", "light": "#D2D6DC", "css": "--tier-4" },
      "notScored":         { "style": "1px dashed text.muted, no fill", "css": "--tier-5" }
    },
    "data": {
      "barFill":  { "alias": "accent.default", "css": "--chart-fill" },
      "barTrack": { "dark": "#2D3642", "light": "#E6E8EC", "css": "--chart-track" }
    },
    "overlay": {
      "scrim": { "dark": "rgba(0,0,0,0.62)", "light": "rgba(10,14,20,0.32)", "css": "--scrim" }
    },
    "focus": {
      "ring": { "alias": "accent.default", "css": "--ring", "spec": "2px solid, 2px offset, on every interactive element via :focus-visible" }
    }
  },

  "typography": {
    "family": { "sans": "Geist, system-ui, sans-serif", "mono": "Geist Mono, ui-monospace, monospace (code only; never for numbers or dates)" },
    "numerals": "font-variant-numeric: tabular-nums on every number, score, count and date",
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "scale": {
      "caption":    { "size": 12, "lineHeight": 16, "weight": 400, "use": "Meta, help text, table headers, section labels (sentence case, weight 500)" },
      "body":       { "size": 13, "lineHeight": 20, "weight": 400, "use": "Default UI text, table cells, buttons (500)" },
      "bodyLarge":  { "size": 14, "lineHeight": 22, "weight": 400, "use": "Long-form text: summaries, descriptions, documents" },
      "titleSmall": { "size": 16, "lineHeight": 22, "weight": 600, "tracking": "-0.01em", "use": "Dialog titles, auth card titles" },
      "title":      { "size": 18, "lineHeight": 24, "weight": 600, "tracking": "-0.015em", "use": "Preview pane title, mobile page titles" },
      "pageTitle":  { "size": 22, "lineHeight": 28, "weight": 600, "tracking": "-0.02em", "use": "App H1 (one per page)" },
      "metric":     { "size": 22, "lineHeight": 26, "weight": 500, "use": "KPI values, match/callback numbers (unit in text.muted at 15px)" },
      "displaySmall":  { "size": 24, "lineHeight": 30, "weight": 600, "tracking": "-0.02em", "use": "Marketing sub-sections" },
      "displayMedium": { "size": 36, "lineHeight": 42, "weight": 600, "tracking": "-0.03em", "use": "Marketing section titles" },
      "displayLarge":  { "size": 44, "lineHeight": 48, "weight": 600, "tracking": "-0.035em", "use": "Marketing statement, pricing H1" },
      "displayXL":     { "size": 60, "lineHeight": 64, "weight": 600, "tracking": "-0.04em", "use": "Landing hero only" }
    }
  },

  "space": {
    "unit": 4,
    "scale": { "0": 0, "0.5": 2, "1": 4, "1.5": 6, "2": 8, "2.5": 10, "3": 12, "4": 16, "5": 20, "6": 24, "7": 28, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80, "24": 96, "30": 120 },
    "layout": {
      "pagePaddingDesktop": 24, "pagePaddingMobile": 16, "sectionGap": 20, "cardPadding": 16,
      "sidebarWidth": 232, "previewPaneWidth": 344, "rightRailWidth": 320, "topBarHeight": 52,
      "marketingContentWidth": 1200, "marketingSectionGap": 96, "readingWidth": 680
    }
  },

  "size": {
    "control": { "sm": 28, "md": 32, "lg": 40, "touch": 48, "use": "Buttons, inputs, selects and segmented controls share these heights so they align in a row" },
    "iconButton": { "sm": 28, "md": 32, "touch": 44, "glyph": { "sm": 14, "md": 16, "touch": 20 }, "use": "glyph is the icon size inside an icon-only button; size.icon is the inline-with-label scale" },
    "icon": { "sm": 13, "md": 15, "lg": 18, "touch": 20, "strokeWidth": 1.6 },
    "row": { "table": 36, "tableHeader": 32, "groupHeader": 36, "listItem": 48, "listItemMobile": 56 },
    "touchTargetMin": 44
  },

  "radius": {
    "xs": { "value": 4, "use": "Tier markers, tiny chips" },
    "sm": { "value": 6, "use": "Buttons, inputs, selects, chips, segmented items" },
    "md": { "value": 8, "use": "Cards/sections, table containers, menus, popovers, toasts, banners" },
    "lg": { "value": 12, "use": "Dialogs, product frames" },
    "full": { "value": 9999, "use": "Avatars, dots, stage rings" }
  },

  "elevation": {
    "none": "Default for every surface. Separation comes from borders and spacing.",
    "overlay": { "dark": "0 16px 48px rgba(0,0,0,.55), 0 2px 6px rgba(0,0,0,.4)", "light": "0 16px 48px rgba(10,14,20,.16), 0 2px 6px rgba(10,14,20,.08)", "css": "--shadow-overlay", "use": "Only dialogs, popovers, menus, toasts, drag ghost" }
  },

  "motion": {
    "duration": { "fast": 100, "base": 160, "slow": 240 },
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "reducedMotion": "Opacity-only fades at duration.fast (existing globals.css rule stays)"
  },

  "zIndex": { "sticky": 10, "dropdown": 40, "overlay": 50, "toast": 60 },

  "breakpoint": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280, "rules": "<768: bottom tab bar, single column, preview pane becomes a full page. 768-1279: sidebar collapses to icons, preview pane becomes a drawer. ≥1280: full layout." },

  "opacity": { "disabled": 0.45 }
}
