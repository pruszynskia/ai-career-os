generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  APPLIED
  HR
  TECHNICAL
  TEAM
  CEO_OR_MANAGER
}

enum PostStatus {
  DRAFT
  SCHEDULED
  SENT
}

enum OfferSource {
  URL
  RAW_TEXT
}

// Single profile per owner. ownerId is a plain column (not a User relation)
// per ADR-005/ADR-003 — multi-user support later means adding a User table
// and turning this into a real foreign key, not a schema rewrite.
model Profile {
  id      String @id @default(cuid())
  ownerId String @unique

  summary    String
  skills     String[]
  // ponytail: unstructured job history blob; normalize into an Experience[]
  // relation if structured querying/filtering by experience is ever needed.
  experience Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CvDocument {
  id      String @id @default(cuid())
  ownerId String

  isMaster Boolean @default(false)
  content  String

  jobOfferId String?
  jobOffer   JobOffer? @relation(fields: [jobOfferId], references: [id])

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([jobOfferId])
}

model JobOffer {
  id      String @id @default(cuid())
  ownerId String

  url         String?
  source      OfferSource
  rawContent  String
  company     String
  title       String
  description String
  matchScore  Int?
  isFavorite  Boolean     @default(false)

  applications Application[]
  tailoredCvs  CvDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model Application {
  id      String @id @default(cuid())
  ownerId String

  jobOfferId String
  jobOffer   JobOffer @relation(fields: [jobOfferId], references: [id])

  sentCvId String
  sentCv   CvDocument @relation(fields: [sentCvId], references: [id])

  recruiterMessage String
  // ponytail: status pipeline tracked via `status` + `updatedAt` only; add a
  // separate StatusChange history table if a full audit trail is needed.
  status           ApplicationStatus @default(APPLIED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([jobOfferId])
  @@index([sentCvId])
}

model Post {
  id      String @id @default(cuid())
  ownerId String

  content     String
  status      PostStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}
